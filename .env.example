# Copy to .env for local development. Never commit .env.
# In production these are set in the Vercel dashboard, not in a file.

# Required. The agent refuses to answer without it.
OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-5-mini. Change it here, no redeploy of code needed.
OPENAI_MODEL=gpt-5-mini

# Optional. Caps one completion — reasoning tokens included, so not the answer
# length. Too low and the reply comes back empty.
MAX_OUTPUT_TOKENS=2000

# Observability. Traces every conversation: the questions visitors ask are the
# most useful signal this page produces.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=ask-rafael

# Optional. Points the corpus somewhere other than ./docs — which is how the
# professional_MCP server reads this very same directory.
# DOCS_PATH=./docs

# Optional. Reasoning effort for the model. Default "low": reading a document
# and summarising it is not a reasoning-heavy task, and effort is latency the
# visitor watches. Leave blank for a model that rejects the parameter.
OPENAI_REASONING_EFFORT=low
